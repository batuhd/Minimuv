<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Minimuv" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0E1116</item>
    </style>

    <!-- Kırpma etkinliği (canhub cropper) AppCompat soyundan tema zorunlu kılar.
         Onay/çevir butonları aksiyon çubuğunda olduğu için NoActionBar OLAMAZ. -->
    <style name="Theme.Minimuv.Crop" parent="Theme.AppCompat">
        <item name="android:windowBackground">#0E1116</item>
    </style>

    <!-- Firebase App Distribution kurulum ekranı (InstallActivity) AppCompatActivity'dir;
         AppCompat soyundan tema zorunlu kılar. -->
    <style name="Theme.Minimuv.FirebaseInstall" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#0E1116</item>
    </style>
</resources>